{
  "name": "inkscope-visualizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build && bun --watch api/index.ts",
    "dev:app": "vite --config app/vite.config.ts",
    "build": "bun run typecheck && vite build --config app/vite.config.ts",
    "start": "bun api/index.ts",
    "typecheck": "tsc -p app/tsconfig.json --noEmit && tsc -p api/tsconfig.json --noEmit",
    "test": "bun run build && bun test api app tools",
    "test:e2e": "bun run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@fontsource-variable/m-plus-1-code": "^5.3.1",
    "@hono/bun": "^1.0.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "hono": "^4.13.14",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.1",
    "three": "^0.186.1",
    "three-stdlib": "^2.36.1",
    "tw-animate-css": "^1.4.0"
  }
}
